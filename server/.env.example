# Server Port
PORT=4000

# Environment Mode
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection String (placeholder only - configure with your local credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_command

# Google Gemini API Key (Backend-only secret; leave empty if testing without AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
